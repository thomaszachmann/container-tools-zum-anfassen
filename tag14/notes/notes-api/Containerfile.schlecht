# notes-api/Containerfile.schlecht – Stand Ende Tag 11 (absichtlich schlecht)
FROM docker.io/library/golang:1.27-alpine
RUN apk update && apk add git curl
WORKDIR /src
COPY . .
RUN go build -o /usr/local/bin/notes-api .
RUN rm -rf /root/.cache/go-build /go/pkg/mod
RUN chmod 755 /usr/local/bin/notes-api
EXPOSE 8080
ENTRYPOINT ["notes-api"]
